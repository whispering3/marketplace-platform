[Unit]
Description=Synchronize confirmed Market deposits
After=network-online.target

[Service]
Type=oneshot
User=market
Group=market
WorkingDirectory=/srv/market/financial
Environment=NODE_ENV=production
EnvironmentFile=/etc/market/financial.env
ExecStart=/usr/bin/node --import tsx scripts/sync-wallet-deposits.ts
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
